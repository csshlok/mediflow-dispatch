# Copy to .env and fill in. Generate the JWT secret with: openssl rand -base64 64
JWT_SECRET=change-me-base64-encoded-64-bytes
USER_DB_PASSWORD=change-me
EMERGENCY_DB_PASSWORD=change-me
AMBULANCE_DB_PASSWORD=change-me
HOSPITAL_DB_PASSWORD=change-me
MATCHING_PASSWORD=change-me
CASE_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

KAFKA_BOOTSTRAP_SERVERS=localhost:29092
REDIS_HOST=localhost
